{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.git",
      "!!.fast-agent",
      "!!.venv",
      "!!**/.venv",
      "!!assets",
      "!!mutants",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!!**/test-results",
      "!!apps/control-web/src/generated/api.ts",
      "!!docs/control-api-v1.openapi.json",
      "!!docs/schema-review",
      "!!examples",
      "!!packages/contracts/src/generated",
      "!!schemas",
      "!!tests/golden"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 88
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  }
}
