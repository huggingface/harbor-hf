{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-hf.invalid/schemas/leaderboard-decision-v1.schema.json",
  "title": "LeaderboardDecisionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "actor",
    "kind",
    "submission_id",
    "submission_digest",
    "catalog_digest",
    "public_row_digest",
    "decision",
    "public_metadata_confirmed"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 160
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "role"],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "const": "operator"
        }
      }
    },
    "kind": {
      "const": "leaderboard.decision"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 160
    },
    "submission_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "public_row_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "enum": ["approved", "rejected"]
    },
    "public_metadata_confirmed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "public_metadata_confirmed": {
            "const": true
          }
        }
      }
    }
  ]
}
