{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-hf.example/schemas/agent-preset-v1.schema.json",
  "title": "AgentPresetV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent",
    "version",
    "harbor_agent",
    "reasoning_option",
    "reasoning_values"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "agent": { "$ref": "#/$defs/slug" },
    "version": { "type": "string", "minLength": 1, "maxLength": 160 },
    "harbor_agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "import_path": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kwargs": { "type": "object" },
        "override_setup_timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600
        }
      },
      "oneOf": [
        { "required": ["name"], "not": { "required": ["import_path"] } },
        { "required": ["import_path"], "not": { "required": ["name"] } }
      ]
    },
    "reasoning_option": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 80 },
        { "type": "null" }
      ]
    },
    "reasoning_values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    }
  },
  "$defs": {
    "slug": {
      "title": "AgentPresetSlug",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    }
  }
}
