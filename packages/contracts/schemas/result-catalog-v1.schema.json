{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-hf.invalid/schemas/result-catalog-v1.schema.json",
  "title": "HarborHFResultCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "record_id",
    "created_at",
    "source_digest",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "kind": { "const": "result.catalog" },
    "record_id": { "$ref": "#/$defs/ResultCatalogId" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_digest": { "$ref": "#/$defs/ResultCatalogDigest" },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/Entry" }
    }
  },
  "$defs": {
    "ResultCatalogId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "ResultCatalogDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "NullableString": {
      "type": ["string", "null"],
      "maxLength": 512
    },
    "PrimaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id",
        "campaign_id",
        "run_id",
        "published_at",
        "benchmark",
        "model",
        "harness",
        "inference_provider",
        "run_outcome",
        "quality",
        "publication_role",
        "task_count",
        "scored_task_count",
        "strict_pass_count",
        "primary_metric",
        "result_path"
      ],
      "properties": {
        "publication_id": { "$ref": "#/$defs/ResultCatalogId" },
        "campaign_id": { "$ref": "#/$defs/ResultCatalogId" },
        "run_id": {
          "oneOf": [{ "$ref": "#/$defs/ResultCatalogId" }, { "type": "null" }]
        },
        "published_at": { "type": "string", "format": "date-time" },
        "benchmark": { "$ref": "#/$defs/NullableString" },
        "model": { "$ref": "#/$defs/NullableString" },
        "harness": { "$ref": "#/$defs/NullableString" },
        "inference_provider": { "$ref": "#/$defs/NullableString" },
        "run_outcome": { "type": "string", "minLength": 1, "maxLength": 80 },
        "quality": { "enum": ["clean", "degraded"] },
        "publication_role": { "enum": ["final", "component", "diagnostic"] },
        "task_count": { "type": "integer", "minimum": 0 },
        "scored_task_count": { "type": "integer", "minimum": 0 },
        "strict_pass_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "primary_metric": {
          "oneOf": [{ "$ref": "#/$defs/PrimaryMetric" }, { "type": "null" }]
        },
        "result_path": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  }
}
