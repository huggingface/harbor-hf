{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-hf.example/schemas/run-presentation-v1.schema.json",
  "title": "RunPresentationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "archived",
    "revision",
    "updated_at",
    "actor"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{24}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "archived": {
      "type": "boolean"
    }
  }
}
