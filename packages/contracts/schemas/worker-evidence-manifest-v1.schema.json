{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harborframework.com/schemas/harbor-hf/worker-evidence-manifest-v1.schema.json",
  "title": "WorkerEvidenceManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "action_id",
    "task_id",
    "objects"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "kind": { "const": "worker.evidence.manifest" },
    "campaign_id": { "$ref": "#/$defs/WorkerEvidenceId" },
    "action_id": { "$ref": "#/$defs/WorkerEvidenceId" },
    "task_id": { "$ref": "#/$defs/WorkerEvidenceId" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/WorkerEvidenceObject" }
    }
  },
  "$defs": {
    "WorkerEvidenceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 160
    },
    "WorkerEvidenceDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "WorkerEvidenceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "digest": { "$ref": "#/$defs/WorkerEvidenceDigest" },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        }
      }
    }
  }
}
