{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harborframework.com/schemas/harbor-hf/inference-review-request-v1.schema.json",
  "title": "Inference Review Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_revision",
    "recipe",
    "model_name",
    "base_url",
    "allowed_hosts"
  ],
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recipe": {
      "$ref": "agent-workbench-v1.schema.json"
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "base_url": {
      "type": ["string", "null"],
      "maxLength": 2048
    },
    "allowed_hosts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
        "maxLength": 253
      },
      "uniqueItems": true
    }
  }
}
