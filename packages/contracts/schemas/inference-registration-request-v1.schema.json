{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harborframework.com/schemas/harbor-hf/inference-registration-request-v1.schema.json",
  "title": "Inference Registration Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_revision", "source_env", "label", "reason"],
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_env": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
      "not": {
        "anyOf": [
          {
            "enum": ["HF_TOKEN", "HF_INFERENCE_TOKEN"]
          },
          {
            "pattern": "^(?:HF_|HUGGING_FACE_|HUGGINGFACE_|HARBOR_HF_|OAUTH_|OPENID_|INFERENCE_API_KEY_)",
            "description": "Reserved authority name"
          },
          {
            "pattern": "(?:^|_)(?:TOKEN|OAUTH|OPENID|CONTROL|AUTH|SESSION|COOKIE|PASSWORD|PRIVATE|SIGNING)(?:_|$)",
            "description": "Reserved authority name"
          },
          {
            "pattern": "^(?:AWS_|AZURE_|GOOGLE_|GCP_|DATABASE_|REDIS_|SSH_|CI_|GITHUB_|LD_|DYLD_|NODE_|PYTHON|PATH$|HOME$|SHELL$|USER$)",
            "description": "Reserved authority name"
          },
          {
            "pattern": "(?:^|_)(?:CREDENTIALS?|AUTHORITY|ACCESS|ENCRYPTION|SERVICE|CLIENT)(?:_|$)",
            "description": "Reserved authority name"
          }
        ]
      }
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 .,:;!?()/_-]{0,499}$"
    }
  }
}
