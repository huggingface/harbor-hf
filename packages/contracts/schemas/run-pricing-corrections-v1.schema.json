{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-hf.example/schemas/run-pricing-corrections-v1.schema.json",
  "title": "RunPricingCorrectionsV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "revisions"],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{24}$"
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "actor", "updated_at", "reason", "pricing"],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "pricing": {
            "$ref": "launch-pricing-v1.schema.json"
          }
        }
      }
    }
  }
}
