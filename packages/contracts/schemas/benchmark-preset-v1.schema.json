{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-hf.example/schemas/benchmark-preset-v1.schema.json",
  "title": "BenchmarkPresetV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "preset", "leaderboard_eligible", "job"],
  "properties": {
    "schema_version": { "const": "v1" },
    "benchmark": { "$ref": "#/$defs/slug" },
    "preset": { "$ref": "#/$defs/slug" },
    "leaderboard_eligible": { "type": "boolean" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasets", "n_attempts", "n_concurrent_trials", "environment"],
      "properties": {
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "path"],
            "properties": {
              "repo": { "type": "string", "pattern": "^https://" },
              "path": { "type": "string", "minLength": 1 },
              "task_names": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "exclude_task_names": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "n_tasks": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "n_attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "n_concurrent_trials": { "type": "integer", "minimum": 1, "maximum": 128 },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "kwargs"],
          "properties": {
            "type": { "const": "hf-sandbox" },
            "kwargs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["flavor", "job_timeout"],
              "properties": {
                "flavor": { "enum": ["cpu-basic", "cpu-upgrade"] },
                "job_timeout": { "const": "30m" }
              }
            }
          }
        },
        "timeout_multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "agent_timeout_multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "verifier_timeout_multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "agent_setup_timeout_multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "environment_build_timeout_multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
            "include_exceptions": { "type": "array", "items": { "type": "string" } },
            "exclude_exceptions": { "type": "array", "items": { "type": "string" } },
            "wait_multiplier": { "type": "number", "exclusiveMinimum": 0 },
            "min_wait_sec": { "type": "number", "minimum": 0 },
            "max_wait_sec": { "type": "number", "minimum": 0 }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "destination"],
                "properties": {
                  "source": { "type": "string" },
                  "destination": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "title": "BenchmarkPresetSlug",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    }
  }
}
