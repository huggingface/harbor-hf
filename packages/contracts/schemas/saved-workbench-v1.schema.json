{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harborframework.com/schemas/harbor-hf/saved-workbench-v1.schema.json",
  "title": "Saved Workbench Configuration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "name", "harbor_job_config"],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "harbor_job_config": {
      "$ref": "harbor-job-config-v1.schema.json",
      "tsType": "import(\"./harbor-job-config-v1.js\").HarborJobConfigV1",
      "title": "Saved Harbor Configuration"
    }
  }
}
