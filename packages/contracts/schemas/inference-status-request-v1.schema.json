{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harborframework.com/schemas/harbor-hf/inference-status-request-v1.schema.json",
  "title": "Inference Status Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_revision", "enabled", "reason"],
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "enabled": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 .,:;!?()/_-]{0,499}$"
    }
  }
}
