    },
    "preset": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "agent_version": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "reasoning_effort": {
      "type": "string"
    },
    "n_attempts": {
      "type": "number"
