{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-hf.example/schemas/leaderboard-row-v1.schema.json",
  "title": "LeaderboardRowV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "preset",
    "agent",
    "agent_version",
    "model",
    "provider",
    "reasoning_effort",
    "n_attempts",
    "n_trials",
    "pass_rate",
    "cost_usd"
