{
  "$defs": {
    "AgentProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "import_path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Import Path"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "reported_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Version"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "revision_kind": {
          "enum": [
            "package",
            "git",
            "harbor-source"
          ],
          "title": "Revision Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "revision",
        "revision_kind"
      ],
      "title": "AgentProfile",
      "type": "object"
    },
    "BenchmarkJudgeSpec": {
      "additionalProperties": false,
      "properties": {
        "api_key_secret_name": {
          "default": "HF_TOKEN",
          "enum": [
            "HF_TOKEN",
            "OPENAI_API_KEY",
            "GEMINI_API_KEY"
          ],
          "title": "Api Key Secret Name",
          "type": "string"
        },
        "api_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Api Url",
          "type": "string"
        },
        "exclude_task_names": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Exclude Task Names",
          "type": "array"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "protocol": {
          "const": "openai-compatible",
          "default": "openai-compatible",
          "title": "Protocol",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "strip_temperature": {
          "default": false,
          "title": "Strip Temperature",
          "type": "boolean"
        },
        "task_names": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Task Names",
          "type": "array"
        }
      },
      "required": [
        "api_url",
        "model"
      ],
      "title": "BenchmarkJudgeSpec",
      "type": "object"
    },
    "BundleBenchmarkSource": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "type": {
          "const": "bundle",
          "default": "bundle",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "content_digest",
        "manifest_sha256"
      ],
      "title": "BundleBenchmarkSource",
      "type": "object"
    },
    "CampaignShardLock": {
      "additionalProperties": false,
      "properties": {
        "shard_digest": {
          "title": "Shard Digest",
          "type": "string"
        },
        "shard_id": {
          "title": "Shard Id",
          "type": "string"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/CampaignTrialLock"
          },
          "title": "Trials",
          "type": "array"
        }
      },
      "required": [
        "shard_id",
        "shard_digest",
        "trials"
      ],
      "title": "CampaignShardLock",
      "type": "object"
    },
    "CampaignTrialLock": {
      "additionalProperties": false,
      "properties": {
        "logical_attempt": {
          "title": "Logical Attempt",
          "type": "integer"
        },
        "task_digest": {
          "title": "Task Digest",
          "type": "string"
        },
        "task_name": {
          "title": "Task Name",
          "type": "string"
        },
        "trial_digest": {
          "title": "Trial Digest",
          "type": "string"
        },
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        }
      },
      "required": [
        "trial_id",
        "trial_digest",
        "task_name",
        "task_digest",
        "logical_attempt"
      ],
      "title": "CampaignTrialLock",
      "type": "object"
    },
    "DeploymentProfile": {
      "additionalProperties": false,
      "properties": {
        "accelerator_count": {
          "default": 1,
          "minimum": 1,
          "title": "Accelerator Count",
          "type": "integer"
        },
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "engine": {
          "$ref": "#/$defs/EngineSpec"
        },
        "hardware": {
          "minLength": 1,
          "title": "Hardware",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "provider": {
          "const": "hf-inference-endpoints",
          "default": "hf-inference-endpoints",
          "title": "Provider",
          "type": "string"
        },
        "region": {
          "minLength": 1,
          "title": "Region",
          "type": "string"
        }
      },
      "required": [
        "id",
        "hardware",
        "region",
        "engine"
      ],
      "title": "DeploymentProfile",
      "type": "object"
    },
    "EndpointRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "served_model_name": {
          "minLength": 1,
          "title": "Served Model Name",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "served_model_name"
      ],
      "title": "EndpointRef",
      "type": "object"
    },
    "EndpointWaveTarget": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/EndpointRef"
        },
        "kind": {
          "const": "inference-endpoint",
          "default": "inference-endpoint",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "endpoint"
      ],
      "title": "EndpointWaveTarget",
      "type": "object"
    },
    "EngineSpec": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "type": "string"
          },
          "title": "Arguments",
          "type": "array"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "secret_names": {
          "items": {
            "type": "string"
          },
          "title": "Secret Names",
          "type": "array"
        }
      },
      "required": [
        "name",
        "image"
      ],
      "title": "EngineSpec",
      "type": "object"
    },
    "ExplicitProviderRoute": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "provider",
          "default": "provider",
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "title": "ExplicitProviderRoute",
      "type": "object"
    },
    "GitBenchmarkSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "pattern": "^(?:https://github\\.com/)?[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9_.-]+(?:\\.git)?$",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "type": {
          "const": "git",
          "default": "git",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "path"
      ],
      "title": "GitBenchmarkSource",
      "type": "object"
    },
    "HarborRuntimeSpec": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "const": "hf-sandbox",
          "default": "hf-sandbox",
          "title": "Environment",
          "type": "string"
        },
        "sandbox_flavor": {
          "default": "cpu-basic",
          "minLength": 1,
          "title": "Sandbox Flavor",
          "type": "string"
        },
        "sandbox_idle_timeout_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Sandbox Idle Timeout Seconds",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/SourcePin"
        }
      },
      "required": [
        "source"
      ],
      "title": "HarborRuntimeSpec",
      "type": "object"
    },
    "JsonValue": {},
    "ModelProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "repo": {
          "minLength": 1,
          "title": "Repo",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "weights": {
          "$ref": "#/$defs/WeightsSpec"
        }
      },
      "required": [
        "id",
        "repo",
        "revision",
        "weights"
      ],
      "title": "ModelProfile",
      "type": "object"
    },
    "PolicyRoute": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "policy",
          "default": "policy",
          "title": "Kind",
          "type": "string"
        },
        "policy": {
          "default": "fastest",
          "enum": [
            "fastest",
            "cheapest",
            "preferred"
          ],
          "title": "Policy",
          "type": "string"
        }
      },
      "title": "PolicyRoute",
      "type": "object"
    },
    "ProviderLimits": {
      "additionalProperties": false,
      "properties": {
        "estimated_wave_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Wave Cost Usd"
        },
        "max_attempts": {
          "default": 1,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_concurrent_requests": {
          "default": 1,
          "minimum": 1,
          "title": "Max Concurrent Requests",
          "type": "integer"
        },
        "max_spend_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Spend Usd"
        },
        "min_request_interval_seconds": {
          "default": 0,
          "maximum": 300,
          "minimum": 0,
          "title": "Min Request Interval Seconds",
          "type": "number"
        }
      },
      "title": "ProviderLimits",
      "type": "object"
    },
    "ProviderTarget": {
      "additionalProperties": false,
      "properties": {
        "api": {
          "default": "chat-completions",
          "enum": [
            "chat-completions",
            "responses"
          ],
          "title": "Api",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "inference-provider",
          "default": "inference-provider",
          "title": "Kind",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/ProviderLimits"
        },
        "model": {
          "minLength": 1,
          "pattern": "^[^\\s:]+/[^\\s:]+$",
          "title": "Model",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "routing": {
          "discriminator": {
            "mapping": {
              "policy": "#/$defs/PolicyRoute",
              "provider": "#/$defs/ExplicitProviderRoute"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PolicyRoute"
            },
            {
              "$ref": "#/$defs/ExplicitProviderRoute"
            }
          ],
          "title": "Routing"
        },
        "service": {
          "const": "hf-inference-providers",
          "default": "hf-inference-providers",
          "title": "Service",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "token_secret_name": {
          "const": "HF_TOKEN",
          "default": "HF_TOKEN",
          "title": "Token Secret Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "model"
      ],
      "title": "ProviderTarget",
      "type": "object"
    },
    "ProviderWaveTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "inference-provider",
          "default": "inference-provider",
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderTarget"
        }
      },
      "required": [
        "provider"
      ],
      "title": "ProviderWaveTarget",
      "type": "object"
    },
    "QuantizationSpec": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "scheme": {
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": [
        "method",
        "scheme"
      ],
      "title": "QuantizationSpec",
      "type": "object"
    },
    "RemoteExecutionSpec": {
      "additionalProperties": false,
      "properties": {
        "harbor": {
          "$ref": "#/$defs/HarborRuntimeSpec"
        },
        "job": {
          "$ref": "#/$defs/RemoteJobSpec"
        },
        "worker": {
          "$ref": "#/$defs/SourcePin"
        }
      },
      "required": [
        "job",
        "worker",
        "harbor"
      ],
      "title": "RemoteExecutionSpec",
      "type": "object"
    },
    "RemoteJobSpec": {
      "additionalProperties": false,
      "properties": {
        "flavor": {
          "default": "cpu-basic",
          "minLength": 1,
          "title": "Flavor",
          "type": "string"
        },
        "image": {
          "pattern": "^.+@sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 10800,
          "maximum": 85800,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "token_secret_name": {
          "const": "HF_TOKEN",
          "default": "HF_TOKEN",
          "title": "Token Secret Name",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "image"
      ],
      "title": "RemoteJobSpec",
      "type": "object"
    },
    "RunLock": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentProfile"
        },
        "agent_setup_timeout_multiplier": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Setup Timeout Multiplier"
        },
        "artifact_bucket": {
          "title": "Artifact Bucket",
          "type": "string"
        },
        "artifact_prefix": {
          "title": "Artifact Prefix",
          "type": "string"
        },
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "benchmark_dataset": {
          "title": "Benchmark Dataset",
          "type": "string"
        },
        "benchmark_dataset_digest": {
          "title": "Benchmark Dataset Digest",
          "type": "string"
        },
        "benchmark_judge": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchmarkJudgeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "benchmark_source": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "bundle": "#/$defs/BundleBenchmarkSource",
                  "git": "#/$defs/GitBenchmarkSource"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/GitBenchmarkSource"
                },
                {
                  "$ref": "#/$defs/BundleBenchmarkSource"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark Source"
        },
        "benchmark_task_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Benchmark Task Digests",
          "type": "object"
        },
        "benchmark_tasks": {
          "items": {
            "type": "string"
          },
          "title": "Benchmark Tasks",
          "type": "array"
        },
        "component_kind": {
          "anyOf": [
            {
              "enum": [
                "base",
                "correction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Component Kind"
        },
        "concurrent_trials": {
          "title": "Concurrent Trials",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deployment": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeploymentProfile"
            },
            {
              "$ref": "#/$defs/ProviderTarget"
            }
          ],
          "title": "Deployment"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "experiment": {
          "title": "Experiment",
          "type": "string"
        },
        "judge_required_tasks": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Required Tasks"
        },
        "model": {
          "$ref": "#/$defs/ModelProfile"
        },
        "publication_role": {
          "enum": [
            "final",
            "component",
            "diagnostic"
          ],
          "title": "Publication Role",
          "type": "string"
        },
        "remote": {
          "$ref": "#/$defs/RemoteExecutionSpec"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "harbor-hf/run-lock/v1alpha1",
          "enum": [
            "harbor-hf/run-lock/v1alpha1",
            "harbor-hf/run-lock/v1alpha2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "serving_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServingProfileBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "spec_digest": {
          "title": "Spec Digest",
          "type": "string"
        },
        "timeout_seconds": {
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "trial_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrialEvidencePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run_id",
        "created_at",
        "experiment",
        "evaluation_id",
        "publication_role",
        "component_kind",
        "spec_digest",
        "benchmark_dataset",
        "benchmark_dataset_digest",
        "benchmark_tasks",
        "benchmark_task_digests",
        "model",
        "deployment",
        "agent",
        "attempts",
        "concurrent_trials",
        "timeout_seconds",
        "artifact_bucket",
        "artifact_prefix",
