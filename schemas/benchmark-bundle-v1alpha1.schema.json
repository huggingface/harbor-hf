{
  "$defs": {
    "BundleDirectory": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": 493,
          "default": 493,
          "title": "Mode",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "type": {
          "const": "directory",
          "default": "directory",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "BundleDirectory",
      "type": "object"
    },
    "BundleFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 8589934592,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "mode": {
          "enum": [
            420,
            493
          ],
          "title": "Mode",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "type": {
          "const": "file",
          "default": "file",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "mode",
        "bytes",
        "sha256"
      ],
      "title": "BundleFile",
      "type": "object"
    },
    "BundlePayload": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 35433480192,
          "minimum": 1,
          "title": "Bytes",
          "type": "integer"
        },
        "filename": {
          "const": "payload.tar.zst",
          "default": "payload.tar.zst",
          "title": "Filename",
          "type": "string"
        },
        "media_type": {
          "const": "application/vnd.harbor-hf.benchmark-bundle.tar+zstd",
          "default": "application/vnd.harbor-hf.benchmark-bundle.tar+zstd",
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "sha256"
      ],
      "title": "BundlePayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "entries": {
      "items": {
        "discriminator": {
          "mapping": {
            "directory": "#/$defs/BundleDirectory",
            "file": "#/$defs/BundleFile"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BundleDirectory"
          },
          {
            "$ref": "#/$defs/BundleFile"
          }
        ]
      },
      "maxItems": 1000000,
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/BundlePayload"
    },
    "schema_version": {
      "const": "harbor-hf/benchmark-bundle/v1alpha1",
      "default": "harbor-hf/benchmark-bundle/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "content_digest",
    "entries",
    "payload"
  ],
  "title": "BenchmarkBundleManifest",
  "type": "object"
}
