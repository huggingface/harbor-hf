{
  "$defs": {
    "BundleBenchmarkSource": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "type": {
          "const": "bundle",
          "default": "bundle",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "content_digest",
        "manifest_sha256"
      ],
      "title": "BundleBenchmarkSource",
      "type": "object"
    },
    "GitBenchmarkSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "pattern": "^(?:https://github\\.com/)?[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9_.-]+(?:\\.git)?$",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "type": {
          "const": "git",
          "default": "git",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "path"
      ],
      "title": "GitBenchmarkSource",
      "type": "object"
    },
    "PackageBenchmarkSourceLock": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*@sha256:[0-9a-f]{64}$",
          "title": "Reference",
          "type": "string"
        },
        "type": {
          "const": "package",
          "default": "package",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "reference"
      ],
      "title": "PackageBenchmarkSourceLock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "harbor-hf/benchmark-source-lock/v1alpha1",
      "default": "harbor-hf/benchmark-source-lock/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "discriminator": {
        "mapping": {
          "bundle": "#/$defs/BundleBenchmarkSource",
          "git": "#/$defs/GitBenchmarkSource",
          "package": "#/$defs/PackageBenchmarkSourceLock"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GitBenchmarkSource"
        },
        {
          "$ref": "#/$defs/BundleBenchmarkSource"
        },
        {
          "$ref": "#/$defs/PackageBenchmarkSourceLock"
        }
      ],
      "title": "Source"
    }
  },
  "required": [
    "source"
  ],
  "title": "BenchmarkSourceLock",
  "type": "object"
}
