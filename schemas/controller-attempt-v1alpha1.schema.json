{
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "input_digest": {
      "title": "Input Digest",
      "type": "string"
    },
    "input_uri": {
      "pattern": "^hf://buckets/[^\\s]+$",
      "title": "Input Uri",
      "type": "string"
    },
    "output_uri": {
      "pattern": "^hf://buckets/[^\\s]+$",
      "title": "Output Uri",
      "type": "string"
    },
    "plan_digest": {
      "title": "Plan Digest",
      "type": "string"
    },
    "reserved_at": {
      "format": "date-time",
      "title": "Reserved At",
      "type": "string"
    },
    "schema_version": {
      "const": "harbor-hf/controller-attempt/v1alpha1",
      "default": "harbor-hf/controller-attempt/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "worker_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Worker Revision",
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "plan_digest",
    "input_digest",
    "input_uri",
    "output_uri",
    "worker_revision",
    "attempt",
    "reserved_at"
